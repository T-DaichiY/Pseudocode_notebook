rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
//  PseudoLab — Firestore Security Rules
//  Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
//
//  Without these rules (i.e. in "test mode") ANY person on the internet can
//  read, overwrite and delete EVERY student's notebooks. This file is the
//  single most important security control in the project.
// ═══════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // A notebook lives at: notebooks/{uid}/saved/{notebookId}
    // Only the signed-in owner of {uid} may touch it.
    match /notebooks/{uid}/saved/{notebookId} {

      allow read, delete: if request.auth != null
                          && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        // No unexpected fields may be written.
        && request.resource.data.keys().hasOnly(['title', 'updatedAt', 'cells', 'sharedState'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.cells is list
        && request.resource.data.cells.size() <= 300
        && request.resource.data.sharedState is map
        && request.resource.data.sharedState.size() <= 500
        // Must be the real server clock, not a client-chosen timestamp.
        && request.resource.data.updatedAt == request.time;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
